COMPANY_NAME=TradeDesk AI
PUBLIC_BASE_URL=https://your-app.up.railway.app
DATABASE_PATH=/data/trades_office.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=true

# Twilio (leave blank to run in dry-run mode: texts are logged, not sent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURES=true
TTS_VOICE=Polly.Joanna-Neural

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PLUS=

# Google Calendar (optional): path to a service-account JSON key
GOOGLE_SERVICE_ACCOUNT_FILE=
