COMPANY_NAME=TradeDesk AI
PUBLIC_BASE_URL=https://your-app.up.railway.app
DATABASE_PATH=/data/trades_office.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-long

# Public website
CONTACT_EMAIL=hello@yourdomain.com
SERVICE_REGION=Central Texas
# Your cell: you get a text for every trial signup (sent from COMPANY_SMS_NUMBER)
FOUNDER_PHONE=
COMPANY_SMS_NUMBER=
# Shop id the website's "Be the customer" demo talks to (run scripts.seed_demo; usually 1). 0 = off
PUBLIC_DEMO_SHOP_ID=0
# Optional: a real phone number visitors can call to hear the demo shop
DEMO_PHONE_NUMBER=

# AI model. Set GEMINI_API_KEY to use Google Gemini (https://aistudio.google.com/apikey);
# otherwise Claude is used with ANTHROPIC_API_KEY. LLM_PROVIDER=gemini|anthropic forces one.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=false

# Twilio (leave blank to run in dry-run mode: texts are logged, not sent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VALIDATE_SIGNATURES=true
TTS_VOICE=Polly.Joanna-Neural

# Stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PLUS=

# Google Calendar (optional): paste the whole service-account JSON key (steps in DEPLOY.md),
# or set GOOGLE_SERVICE_ACCOUNT_FILE to the key file's path instead.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
